{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/*.ts": {
      "includeFiles": "shared/**"
    }
  },
  "rewrites": [{ "source": "/((?!api/|_vercel/).*)", "destination": "/index.html" }]
}
